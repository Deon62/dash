# Copy to `.env`. Everything here is optional — the app points at the hosted
# API with no configuration at all.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time, so
# nothing secret belongs in this file. None of these are secrets: the API URL is
# public, and a Google OAuth client id is a public identifier — the client
# *secret* is never used by a mobile app and must not appear here.
#
# Metro reads .env when it starts, so after changing anything restart with
# `npx expo start -c`.

# --- The API ------------------------------------------------------------------
#
# Origin only: no trailing slash and no /api/v1, since the version prefix lives
# in `src/api/endpoints.js`. Omit it entirely to use production, which is what
# `src/api/client.js` falls back to. Set it to point a build at staging or at a
# server running on your machine.
EXPO_PUBLIC_API_URL=https://als.ardena.xyz

# --- Google sign-in -----------------------------------------------------------
#
# Leave these blank and the Google button is not shown at all. That is
# deliberate: a consent screen that cannot complete is worse than an option that
# was never offered, and the server refuses Google tokens unless its own
# GOOGLE_CLIENT_IDS is set to match.
#
# The web client id is the audience the server verifies against, so it is
# required even on a phone — the native clients below are issued tokens *for*
# it. All three come from the same Google Cloud project's Credentials page.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- PostHog ------------------------------------------------------------------
#
# The project API key from PostHog → Settings → Project. It is a write-only
# public key, not a secret: it can send events and nothing else, which is why it
# ships in the bundle like the Google client ids do.
#
# Leave it blank and analytics is switched off entirely — no provider, no
# events, no recordings. That is the right setting for Expo Go, where the native
# module behind session replay and native crash capture is not present anyway.
EXPO_PUBLIC_POSTHOG_KEY=

# US cloud by default. Change to https://eu.i.posthog.com if the project was
# created in the EU region; a key sent to the wrong region is simply rejected.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
