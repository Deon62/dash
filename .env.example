# Copy to `.env` and fill in from your Supabase project settings.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time. That is
# fine for both values here — the anon key grants nothing without a signed-in
# user, and Row Level Security is what actually protects the data.
#
# Never put the service role key in this file. It bypasses RLS entirely and
# belongs only on the backend (Render + Supabase function secrets).
#
# Metro reads .env when it starts, so after changing anything here restart with
# `npx expo start -c`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The API. Origin only, no trailing slash and no /api/v1 — the version prefix
# lives in `src/api/endpoints.js`. Absent means "no backend", which is a
# supported state: the app is local-first and every screen still works.
EXPO_PUBLIC_API_URL=https://als.ardena.xyz
